# ============================================================
# SAFE ROUTE AI — environment template
# Copy this file to `.env` and fill in what you have.
# The app RUNS WITH NO KEYS (demo mode); each key you add
# upgrades that subsystem from a fallback to the real service.
# ============================================================

# ---- Frontend (safe to expose — anon/publishable only) ----
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:5000

# ---- Backend (SECRET — server only, never sent to browser) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key is used to verify user JWTs server-side:
SUPABASE_ANON_KEY=

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Routing ----
OSRM_BASE_URL=https://router.project-osrm.org

# ---- Geocoding ----
# One of: mapbox | google | internal   (leave blank = auto-detect from keys)
GEOCODING_PROVIDER=
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ---- News ----
NEWS_API_KEY=

# ---- Application ----
PORT=5000
CLIENT_URL=http://localhost:5173
DEMO_MODE=true

# Pilot city bounding centre (Delhi NCR) — used for demo/news defaults
PILOT_CITY=Delhi NCR
PILOT_LAT=28.6139
PILOT_LNG=77.2090
